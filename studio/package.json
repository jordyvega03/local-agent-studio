{
  "name": "local-agent-studio",
  "private": true,
  "type": "module",
  "description": "AI Studio: interfaz web de los agentes de `ai` (ver docs/PLAN-STUDIO.md)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev:server": "node --watch server/main.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "11.3.1",
    "fastify": "5.12.5",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
