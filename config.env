# =============================================================================
# Configuración del agente local. La leen bin/ai y docker/compose.yml.
# Cambia valores aquí; no hace falta tocar el script.
# =============================================================================

# --- Modelo ejecutor (local, vía Ollama) -------------------------------------
# gpt-oss:20b      ~14 GB  cabe entero en GPU, buen uso de herramientas (default)
# qwen3-coder:30b  ~19 GB  mejor código, pero justo en 24 GB (parte va a CPU)
# devstral:24b     ~14 GB  alternativa orientada a agentes
EXECUTOR_MODEL="gpt-oss:20b"

# --- Planificador (Opus vía Claude Code, usa tu login de Claude) -------------
PLANNER_MODEL="opus"

# Solo para `ai architect` (Aider con Opus como arquitecto dentro del contenedor).
# Necesita ANTHROPIC_API_KEY exportada en tu shell; nunca la escribas aquí.
ARCHITECT_MODEL="anthropic/claude-opus-5-5"

# --- Ollama ------------------------------------------------------------------
OLLAMA_HOST="127.0.0.1:11434"   # solo localhost: nadie de la red puede usarlo
OLLAMA_CONTEXT_LENGTH=32768     # contexto por defecto (más = más RAM)
OLLAMA_KEEP_ALIVE="30m"         # descarga el modelo tras 30 min sin uso
OLLAMA_MAX_LOADED_MODELS=1      # nunca dos modelos a la vez en memoria
OLLAMA_NUM_PARALLEL=1           # una petición a la vez = menos RAM
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE="q8_0"     # cache de contexto cuantizada: ~50% menos RAM

# --- Medidor de tokens -------------------------------------------------------
# Proxy entre Aider y Ollama que registra tokens y velocidad de cada respuesta
# (logs/tokens.jsonl y proyecto/.ai/logs/<plan>.tokens.jsonl). Lo arranca `ai up`.
# 0 = Aider habla directamente con Ollama (sin métricas de tokens).
TOKEN_METER=1
TOKEN_METER_PORT=11435   # solo 127.0.0.1; el contenedor llega vía host.docker.internal

# --- Contenedor ejecutor -----------------------------------------------------
AIDER_IMAGE="paulgauthier/aider:v0.86.2"   # versión fijada; actualizar a mano
EXECUTOR_MEM_LIMIT="2g"
EXECUTOR_CPUS="4"

# --- Panel web (ai dashboard) ------------------------------------------------
# Escucha solo en 127.0.0.1. Cámbialo si el puerto está ocupado.
DASHBOARD_PORT=8765

# --- AI Studio (ai studio) ---------------------------------------------------
# Interfaz React (studio/). Escucha solo en 127.0.0.1 y pide un token por arranque.
STUDIO_PORT=8766
STUDIO_MIN_NODE=22.18   # Node ejecuta el servidor TypeScript sin compilar desde esta versión
STUDIO_METRICS_INTERVAL_MS=1000   # cada cuánto se miden CPU/RAM/GPU (una lectura para todos)
STUDIO_METRICS_WINDOW_MIN=15      # minutos de histórico en memoria para las gráficas
STUDIO_ALERT_MEM_FREE=15          # % de memoria libre por debajo del cual el Studio avisa
STUDIO_JOB_HISTORY=30             # trabajos terminados que el Studio recuerda (en memoria)
STUDIO_JOB_BUFFER_KB=512          # salida guardada por trabajo, para verla si llegas a mitad

# Raíz de tus proyectos (permite usar `ai exec mi-app` en vez de la ruta completa)
PROJECTS_ROOT="$HOME/Documents"
